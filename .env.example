# SaaS mode: Clerk + Convex (default). Secrets are never bundled into the frontend.
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key
CLERK_JWT_ISSUER_URL=https://your-instance.clerk.accounts.dev
CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_SITE_URL=https://your-deployment.convex.site
PODU_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ElevenLabs API key (required on the Bun server AND in Convex environment)
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# ElevenLabs agent IDs — create three conversational AI agents in the dashboard
# and paste their IDs here (see README.md step 2).
ELEVENLABS_AGENT_ID_FUN=your_fun_agent_id
ELEVENLABS_AGENT_ID_EDU=your_edu_agent_id
ELEVENLABS_AGENT_ID_DEEP=your_deep_agent_id

# Set in the Convex dashboard, not in the browser:
# ELEVENLABS_WEBHOOK_SECRET=secret_from_your_signed_post_call_webhook
# MEMORY_API_URL=https://your-provider.example/v1/chat/completions
# MEMORY_API_KEY=your_summarizer_key
# MEMORY_MODEL=your_fast_summarizer_model

# Optional localhost-only demo without Clerk/Convex; disabled in production.
# PODU_LOCAL_MODE=true

# Optional: override host/port (defaults: 127.0.0.1:3000)
# HOST=127.0.0.1
# PORT=3000
